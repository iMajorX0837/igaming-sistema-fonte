# Secrets compartilhados entre TODAS as casas (mesma VPS).
# Copie para secrets.env (sem .example) e preencha UMA VEZ:
#   cp tenants/_shared/secrets.env.example tenants/_shared/secrets.env
#   nano tenants/_shared/secrets.env
#
# Ou gere automaticamente de uma casa que já funciona:
#   ./scripts/init-platform-secrets.sh stewgaming
#
# NÃO coloque Supabase aqui — cada casa tem tenants/<slug>/supabase.env

# --- PlayFivers ---
PLAYFIVER_AGENT_TOKEN=
PLAYFIVER_SECRET_KEY=

# --- CPF Hub ---
CPFHUB_API_KEY=

# --- MisticPay (opcional — preferir Admin > Financeiro) ---
# MISTICPAY_CI=
# MISTICPAY_CS=
# MISTICPAY_API_URL=https://api.misticpay.com/api
# MISTICPAY_WEBHOOK_SECRET=

# --- BSPay (opcional) ---
# PAYMENT_GATEWAY=misticpay
# BSPAY_CLIENT_ID=
# BSPAY_CLIENT_SECRET=
# BSPAY_SIGNING_KEY=
# BSPAY_WEBHOOK_SECRET=
# BSPAY_API_URL=https://api.bspay.co

# --- VeoPag (opcional) ---
# VEOPAG_CLIENT_ID=
# VEOPAG_CLIENT_SECRET=
# VEOPAG_WEBHOOK_SECRET=
# VEOPAG_API_URL=https://api.veopag.com

# --- Aviator / API (defaults de produção) ---
AVIATOR_GAME_ENABLED=true
AVIATOR_PYTHON_PORT=8001
AVIATOR_PYTHON_AUTOSTART=true
AVIATOR_API_ENABLED=false
GAME_LAUNCH_MOCK=false
