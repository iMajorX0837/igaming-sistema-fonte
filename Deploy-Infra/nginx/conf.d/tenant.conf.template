# Gerado por add-tenant.sh — use: sed -e 's/___SLUG__/SLUG/g' -e 's/___DOMAIN___/dominio.com/g' tenant.conf.template > SLUG.conf
# Upstream via variável + DNS do Docker: nginx sobe mesmo se o container da API ainda não existir.

server {
  listen 80;
  server_name ___DOMAIN___ www.___DOMAIN___;
  resolver 127.0.0.11 valid=10s ipv6=off;

  root /var/www/tenants/___SLUG__/front;
  index index.html;

  location /api/ {
    set $api_upstream api-___SLUG__:3000;
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400;
  }

  location /aviator/ {
    set $api_upstream api-___SLUG__:3000;
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400;
  }

  location /webhook {
    set $api_upstream api-___SLUG__:3000;
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location /health {
    set $api_upstream api-___SLUG__:3000;
    proxy_pass http://$api_upstream/health;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

