# =============================================================================
# VenuzBET — PlayFiverAPI (servidor Node)
# Copie para .env e preencha:  copy .env.example .env
# =============================================================================

# --- Ambiente ---
PORT=3000
NODE_ENV=production
PUBLIC_API_URL=https://api.SEUDOMINIO.com
# Site do jogador (Aviator iframe + cookies). Em produção multi-subdomínio: https://SEUDOMINIO.com
PUBLIC_SITE_URL=https://SEUDOMINIO.com

# --- Segurança ---
# Pentest local: node scripts/pentest-security.js
# SQL: execute patch_security_hardening.sql e patch_deposit_security.sql no Supabase
# Origens permitidas para CORS com cookies (M10: credentials só com origem explícita na lista)
CORS_ORIGINS=https://SEUDOMINIO.com,https://www.SEUDOMINIO.com,https://admin.SEUDOMINIO.com,https://api.SEUDOMINIO.com,http://SEUDOMINIO.com,http://www.SEUDOMINIO.com,http://admin.SEUDOMINIO.com,http://api.SEUDOMINIO.com
# Só true se a API estiver ATRÁS de nginx/cloudflare que define X-Forwarded-For (M6)
# TRUST_PROXY=true

# --- Supabase ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Aviator (clone Spribe) ---
AVIATOR_GAME_ENABLED=true
AVIATOR_PYTHON_PORT=8001
AVIATOR_PYTHON_AUTOSTART=true
# NUNCA true em produção — API legada sem auth (C6). Use /aviator/wallet + Python.
AVIATOR_API_ENABLED=false
# AVIATOR_DISCORD_WEBHOOK=
# AVIATOR_RTP_PAGE_ENABLED=false

# --- PlayFivers ---
PLAYFIVER_AGENT_TOKEN=
PLAYFIVER_SECRET_KEY=
# PLAYFIVERS_UPSTREAM_URL=https://api.playfivers.com

# --- MisticPay (PIX depósito/saque) — opcional se configurar no Admin > MisticPay ---
# MISTICPAY_CI=
# MISTICPAY_CS=
# MISTICPAY_API_URL=https://api.misticpay.com/api
# MISTICPAY_WEBHOOK_SECRET=

# --- BSPay (PIX depósito/saque) — opcional se configurar no Admin > BSPay ---
# PAYMENT_GATEWAY=misticpay
# BSPAY_CLIENT_ID=
# BSPAY_CLIENT_SECRET=
# BSPAY_SIGNING_KEY=
# BSPAY_WEBHOOK_SECRET=
# BSPAY_API_URL=https://api.bspay.co

# --- VeoPag (PIX depósito/saque) — opcional se configurar no Admin > Gateway de Pagamentos ---
# VEOPAG_CLIENT_ID=
# VEOPAG_CLIENT_SECRET=
# VEOPAG_WEBHOOK_SECRET=
# VEOPAG_API_URL=https://api.veopag.com

# --- CPF Hub (validação de CPF no modal de cadastro — sem login) ---
CPFHUB_API_KEY=

# --- Segurança ---
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AVIATOR_INTERNAL_SECRET=
AVIATOR_GAME_SESSION_SECRET=
# Secret exclusivo para X-Internal-Api-Secret (ex.: prize_wheel/grant server-side).
# Deve ser diferente de AVIATOR_INTERNAL_SECRET (L2).
INTERNAL_API_SECRET=

# --- PlayFivers (slots / cassino externo) ---
# RTP enviado no game_launch (servidor ignora valor do client — H6)
# PLAYFIVER_USER_RTP=70

# --- Dev / testes locais (não usar em produção) ---
GAME_LAUNCH_MOCK=false
# PLAYFIVER_WEBHOOK_SKIP_VALIDATION=true
# PlayFivers em produção envia só type + user_code (+ slot) — sem agent_code no body.
# Mantém true (padrão). false = exige credenciais no body/header (saldo 0 nos jogos se o painel não enviar).
# PLAYFIVER_WEBHOOK_TRUST_CALLBACK=true
